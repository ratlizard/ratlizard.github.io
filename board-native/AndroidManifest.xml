<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.ratlizard.deerlizard"
    android:versionCode="1"
    android:versionName="0.1">
    <uses-sdk android:minSdkVersion="30" android:targetSdkVersion="33" />
    <!-- Remote.java, in a test build only. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:label="Deerlizard"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:extractNativeLibs="true"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|navigation|screenLayout|uiMode|smallestScreenSize|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
